{
  "name": "bestpresso",
  "private": true,
  "version": "0.1.32-patch005",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "i18n:check": "node --experimental-strip-types scripts/i18n.ts check && node --experimental-strip-types scripts/i18n-audit.ts",
    "i18n:report": "node --experimental-strip-types scripts/i18n.ts report",
    "i18n:review": "node --experimental-strip-types scripts/i18n.ts review",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
