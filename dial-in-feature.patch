+      <div className="dial-in-compass__columns dial-in-compass__columns--head" aria-hidden="true"><span className="dial-in-compass__axis">{t('insights.dialIn.taste.strengthAxis')}</span></div>
+      {strengths.map(strength => <div className="dial-in-compass__row" key={strength}>
+        <span className="dial-in-compass__row-label" aria-hidden="true">{label(strength)}</span>
+        {extractions.map(extraction => {
+          const selected = value?.extraction === extraction && value.strength === strength
+          return <button key={extraction} type="button" role="radio" aria-checked={selected}
+            className={`dial-in-compass__cell dial-in-compass__cell--${extraction}-${strength}${selected ? ' dial-in-compass__cell--selected' : ''}`}
+            aria-label={t('insights.dialIn.taste.cellAriaLabel', { extraction: label(extraction), strength: label(strength) })}
+            onClick={() => onChange({ extraction, strength, drying: value?.drying ?? false })}><i aria-hidden="true" /></button>
+        })}
+      </div>)}
+      <div className="dial-in-compass__columns" aria-hidden="true"><span />{extractions.map(extraction => <span key={extraction}>{label(extraction)}</span>)}</div>
+      <span className="dial-in-compass__axis dial-in-compass__axis--extraction" aria-hidden="true">{t('insights.dialIn.taste.extractionAxis')}</span>
+    </div>
+    <label className="dial-in-toggle">
+      <input type="checkbox" checked={value?.drying ?? false} disabled={!value} onChange={(event) => value && onChange({ ...value, drying: event.target.checked })} />
+      <span>{t('insights.dialIn.taste.drying')}</span>
+    </label>
+  </div>
+}
+
+export function ShotDialInPanel({ points, shotId, dose, yieldGrams, grindSetting, onClose }: ShotDialInPanelProps) {
+  const source = getDecaidEndpoints().apiBase
+  const analysis = useMemo(() => analyseShot(points), [points])
+  const peakPressure = useMemo(() => points.reduce<number | undefined>((peak, point) => typeof point.pressure === 'number' && Number.isFinite(point.pressure) ? Math.max(peak ?? 0, point.pressure) : peak, undefined), [points])
