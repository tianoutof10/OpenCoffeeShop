diff --git a/src/features/insights/dialIn.ts b/src/features/insights/dialIn.ts
new file mode 100644
index 0000000..03ae814
--- /dev/null
+++ b/src/features/insights/dialIn.ts
@@ -0,0 +1,130 @@
+import type { ShotAnalysis } from '../../domain/shotAnalysis.ts'
+import { hasFinding } from '../../domain/shotAnalysis.ts'
+
+/**
+ * Taste-first dial-in: one next step from the espresso compass plus puck
+ * evidence. Deterministic; see docs/shot-analysis-and-dial-in.md for the rules.
+ * Telemetry can only rule levers in or out. It never overrides the taste input.
+ */
+
+export type ExtractionTaste = 'sour' | 'balanced' | 'bitter'
+export type StrengthTaste = 'weak' | 'balanced' | 'strong'
+
+export interface TasteNote {
+  extraction: ExtractionTaste
+  strength: StrengthTaste
+  /** Drying, harsh or astringent finish. Often uneven extraction. */
+  drying?: boolean
+}
+
+export interface ShotContext {
+  /** Dose in grams, when known. */
+  dose?: number
+  /** Final beverage mass in grams, when known. */
+  yield?: number
+  grindSetting?: string
+}
+
+export type DialInStep =
+  | { kind: 'keep' }
+  | { kind: 'puckPrep' }
+  | { kind: 'lowerPeakPressure'; fromBar?: number; toBar: number }
+  | { kind: 'grindFiner'; grindSetting?: string }
+  | { kind: 'grindCoarser'; grindSetting?: string }
+  | { kind: 'longerYield'; fromGrams?: number; toGrams?: number }
+  | { kind: 'shorterYield'; fromGrams?: number; toGrams?: number }
+  | { kind: 'moreDose'; fromGrams?: number; toGrams?: number; toYieldGrams?: number }
+  | { kind: 'lessDose'; fromGrams?: number; toGrams?: number; toYieldGrams?: number }
+
+export type DialInReason =
+  | 'chokedFlow'
+  | 'puckDrop'
+  | 'drying'
+  | 'sourStrong' | 'sourBalanced' | 'sourWeak'
+  | 'bitterWeak' | 'bitterBalanced' | 'bitterStrong'
+  | 'balancedWeak' | 'balancedStrong'
+  | 'balanced'
+  | 'ratioAlreadyLong' | 'ratioAlreadyShort'
+
+export interface DialInAdvice {
+  primary: DialInStep
+  secondary?: DialInStep
+  reason: DialInReason
+  /** Whether the advice leaned on telemetry, the cup, or both. */
+  basis: 'taste' | 'telemetry' | 'both'
+  ratio?: number
+}
+
+export const DIAL_IN_LIMITS = {
+  yieldStepShare: 0.1,
+  minimumYieldStepGrams: 2,
+  doseStepGrams: 1,
+  longRatio: 2.6,
+  shortRatio: 1.8,
+  lowerPeakPressureBar: 6.5,
+} as const
+
+const finitePositive = (value: number | undefined): value is number => typeof value === 'number' && Number.isFinite(value) && value > 0
+
+export function brewRatio(context: ShotContext) {
+  return finitePositive(context.dose) && finitePositive(context.yield) ? context.yield / context.dose : undefined
+}
+
+function yieldStep(context: ShotContext, direction: 1 | -1): DialInStep {
+  if (!finitePositive(context.yield)) return { kind: direction > 0 ? 'longerYield' : 'shorterYield' }
+  const step = Math.max(DIAL_IN_LIMITS.minimumYieldStepGrams, Math.round(context.yield * DIAL_IN_LIMITS.yieldStepShare))
+  const fromGrams = Math.round(context.yield)
+  return { kind: direction > 0 ? 'longerYield' : 'shorterYield', fromGrams, toGrams: Math.max(1, fromGrams + direction * step) }
+}
+
+function doseStep(context: ShotContext, direction: 1 | -1): DialInStep {
+  const kind = direction > 0 ? 'moreDose' as const : 'lessDose' as const
+  if (!finitePositive(context.dose)) return { kind }
+  const toGrams = Math.max(1, context.dose + direction * DIAL_IN_LIMITS.doseStepGrams)
+  const ratio = brewRatio(context)
+  return { kind, fromGrams: context.dose, toGrams, toYieldGrams: ratio === undefined ? undefined : Math.round(toGrams * ratio) }
+}
+
+const grind = (kind: 'grindFiner' | 'grindCoarser', context: ShotContext): DialInStep => ({ kind, ...(context.grindSetting?.trim() && context.grindSetting !== '—' ? { grindSetting: context.grindSetting.trim() } : {}) })
+
+/** The taste-only step for a compass cell, honouring ratio limits. */
+function tasteStep(taste: TasteNote, context: ShotContext): { step: DialInStep; reason: DialInReason } {
+  const ratio = brewRatio(context)
+  const { extraction, strength } = taste
+  if (extraction === 'sour') {
+    if (strength === 'weak') return { step: grind('grindFiner', context), reason: 'sourWeak' }
+    if (ratio !== undefined && ratio >= DIAL_IN_LIMITS.longRatio) return { step: grind('grindFiner', context), reason: 'ratioAlreadyLong' }
+    return { step: yieldStep(context, 1), reason: strength === 'strong' ? 'sourStrong' : 'sourBalanced' }
+  }
+  if (extraction === 'bitter') {
+    if (strength === 'strong') return { step: grind('grindCoarser', context), reason: 'bitterStrong' }
+    if (ratio !== undefined && ratio <= DIAL_IN_LIMITS.shortRatio) return { step: grind('grindCoarser', context), reason: 'ratioAlreadyShort' }
+    return { step: yieldStep(context, -1), reason: strength === 'weak' ? 'bitterWeak' : 'bitterBalanced' }
+  }
+  if (strength === 'weak') return { step: doseStep(context, 1), reason: 'balancedWeak' }
+  if (strength === 'strong') return { step: doseStep(context, -1), reason: 'balancedStrong' }
+  return { step: { kind: 'keep' }, reason: 'balanced' }
+}
+
+export function recommendNextShot(taste: TasteNote, analysis: Pick<ShotAnalysis, 'analysable' | 'findings'> | undefined, context: ShotContext = {}, peakPressureBar?: number): DialInAdvice {
+  const ratio = brewRatio(context)
+  const offBalance = taste.extraction !== 'balanced' || taste.strength !== 'balanced' || taste.drying === true
+  const fromTaste = tasteStep(taste, context)
+  const secondaryTaste = fromTaste.step.kind === 'keep' ? undefined : fromTaste.step
+
+  if (analysis && hasFinding(analysis, 'chokedFlow') && offBalance) {
+    // Never pair "coarser" with a contradictory or duplicate grind step.
+    const secondary = secondaryTaste && secondaryTaste.kind !== 'grindFiner' && secondaryTaste.kind !== 'grindCoarser' ? secondaryTaste : undefined
+    return { primary: grind('grindCoarser', context), ...(secondary ? { secondary } : {}), reason: 'chokedFlow', basis: 'both', ratio }
+  }
+  if (analysis && hasFinding(analysis, 'suddenResistanceDrop') && offBalance) {
+    return { primary: { kind: 'puckPrep' }, ...(secondaryTaste ? { secondary: secondaryTaste } : {}), reason: 'puckDrop', basis: 'both', ratio }
+  }
+  if (taste.drying) {
+    const lowerPressure: DialInStep = { kind: 'lowerPeakPressure', ...(peakPressureBar !== undefined && Number.isFinite(peakPressureBar) ? { fromBar: Math.round(peakPressureBar * 10) / 10 } : {}), toBar: DIAL_IN_LIMITS.lowerPeakPressureBar }
+    const pressureAlreadyLow = peakPressureBar !== undefined && peakPressureBar <= DIAL_IN_LIMITS.lowerPeakPressureBar + 0.3
+    const secondary = pressureAlreadyLow ? secondaryTaste : lowerPressure
+    return { primary: { kind: 'puckPrep' }, ...(secondary ? { secondary } : {}), reason: 'drying', basis: 'taste', ratio }
+  }
+  return { primary: fromTaste.step, reason: fromTaste.reason, basis: 'taste', ratio }
+}
