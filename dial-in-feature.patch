+function TasteCompass({ value, onChange }: { value: TasteNote | undefined; onChange: (note: TasteNote) => void }) {
+  const label = (taste: ExtractionTaste | StrengthTaste) => t(`insights.dialIn.taste.${taste}`)
+  return <div className="dial-in-compass">
