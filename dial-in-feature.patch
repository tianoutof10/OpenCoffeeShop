diff --git a/src/features/insights/tasteNotesStorage.ts b/src/features/insights/tasteNotesStorage.ts
new file mode 100644
index 0000000..5464582
--- /dev/null
+++ b/src/features/insights/tasteNotesStorage.ts
@@ -0,0 +1,50 @@
+import type { ExtractionTaste, StrengthTaste, TasteNote } from './dialIn.ts'
+
+/**
+ * Device-local taste journal, scoped per Decaid gateway and keyed by shot ID.
+ * Mirrors stageEvidenceStorage: bounded, tolerant of unavailable storage, and
+ * never written to Decaid until a shot-annotation contract is confirmed.
+ */
+export interface SavedTasteNote extends TasteNote { recordedAt: string }
+
+const MAX_NOTES = 1_000
+const keyFor = (source: string) => `bestpresso-taste-notes-v1:${source}`
+const memory = new Map<string, Record<string, SavedTasteNote>>()
+const extractions: ExtractionTaste[] = ['sour', 'balanced', 'bitter']
+const strengths: StrengthTaste[] = ['weak', 'balanced', 'strong']
+
+function read(source: string): Record<string, SavedTasteNote> {
+  try {
+    const stored = localStorage.getItem(keyFor(source))
+    if (stored) {
+      const value = JSON.parse(stored)
+      if (value && typeof value === 'object' && !Array.isArray(value)) return value
+    }
+  } catch { /* fall back to memory when storage is unavailable */ }
+  return memory.get(source) ?? {}
+}
+
+export function normalizeTasteNote(value: unknown): SavedTasteNote | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const candidate = value as Partial<SavedTasteNote>
+  if (!extractions.includes(candidate.extraction as ExtractionTaste) || !strengths.includes(candidate.strength as StrengthTaste)) return undefined
+  return {
+    extraction: candidate.extraction as ExtractionTaste,
+    strength: candidate.strength as StrengthTaste,
+    drying: candidate.drying === true,
+    recordedAt: typeof candidate.recordedAt === 'string' ? candidate.recordedAt : new Date(0).toISOString(),
+  }
+}
+
+export function readTasteNote(source: string, shotId?: string) {
+  return shotId ? normalizeTasteNote(read(source)[shotId]) : undefined
+}
+
+export function saveTasteNote(source: string, shotId: string, note: TasteNote, now = new Date()) {
+  const entries = Object.entries(read(source)).filter(([id]) => id !== shotId).slice(-(MAX_NOTES - 1))
+  const saved: SavedTasteNote = { extraction: note.extraction, strength: note.strength, drying: note.drying === true, recordedAt: now.toISOString() }
+  const next = Object.fromEntries([...entries, [shotId, saved]])
+  memory.set(source, next)
+  try { localStorage.setItem(keyFor(source), JSON.stringify(next)) } catch { /* preserved in memory */ }
+  return saved
+}
