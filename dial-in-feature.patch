+  // A just-finished live pull carries a local `live:` ID until Decaid persists it.
+  const persistableId = shotId && !shotId.startsWith('live:') ? shotId : undefined
+  const saved = chosen && taste !== undefined && persistableId !== undefined
+  const closeRef = useRef<HTMLButtonElement>(null)
+  useEffect(() => { closeRef.current?.focus() }, [])
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => { if (event.key === 'Escape') onClose() }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [onClose])
+
+  // Persist the barista's choice, including once a live pull receives its Decaid ID.
+  useEffect(() => {
+    if (chosen && taste && persistableId) saveTasteNote(source, persistableId, taste)
+  }, [chosen, taste, persistableId, source])
+
+  const context = { dose, yield: yieldGrams, grindSetting }
+  const advice = taste ? recommendNextShot(taste, analysis, context, peakPressure) : undefined
+  const ratio = dose && yieldGrams ? yieldGrams / dose : undefined
+  const chooseTaste = (note: TasteNote) => {
+    setTaste(note)
+    setChosen(true)
+  }
+
+  return <div className="dial-in-backdrop" role="presentation" onPointerDown={(event) => { if (event.target === event.currentTarget) onClose() }}>
+    <aside className="dial-in-panel" role="dialog" aria-modal="true" aria-labelledby="dial-in-title">
+      <header className="dial-in-panel__header">
+        <div><h2 id="dial-in-title">{t('insights.dialIn.title')}</h2><p>{t('insights.dialIn.subtitle')}</p></div>
+        <button ref={closeRef} className="live-pull-action live-pull-action--close" type="button" onClick={onClose}>{t('insights.dialIn.close')}</button>
+      </header>
+      <section className="dial-in-panel__section" aria-labelledby="dial-in-puck">
+        <h3 id="dial-in-puck">{t('insights.dialIn.puckHeading')}</h3>
+        <PuckSummary analysis={analysis} ratio={ratio} />
+      </section>
+      <section className="dial-in-panel__section" aria-labelledby="dial-in-taste">
+        <h3 id="dial-in-taste">{t('insights.dialIn.tasteHeading')}</h3>
+        {!taste && <p className="dial-in-panel__muted">{t('insights.dialIn.taste.prompt')}</p>}
+        <TasteCompass value={taste} onChange={chooseTaste} />
+        {saved && <p className="dial-in-panel__saved" role="status">{t('insights.dialIn.taste.saved')}</p>}
+      </section>
+      {advice && <section className="dial-in-panel__section dial-in-next" aria-labelledby="dial-in-next" aria-live="polite">
+        <h3 id="dial-in-next">{t('insights.dialIn.nextHeading')}</h3>
+        <p className="dial-in-next__primary">{stepText(advice.primary)}</p>
+        {advice.secondary && <p className="dial-in-next__secondary"><span>{advice.primary.kind === 'puckPrep' ? t('insights.dialIn.thenAfterPrep') : t('insights.dialIn.then')}</span>{stepText(advice.secondary)}</p>}
+        <p className="dial-in-next__why"><span>{t('insights.dialIn.why')}</span>{t(`insights.dialIn.reason.${advice.reason}`, { ratio: advice.ratio === undefined ? '—' : t('insights.dialIn.ratioValue', { ratio: formatDecimal(advice.ratio, 1) }) })}</p>
+        <p className="dial-in-panel__method">{advice.basis === 'both' ? t('insights.dialIn.basis.both') : t('insights.dialIn.basis.taste')}</p>
+      </section>}
+    </aside>
